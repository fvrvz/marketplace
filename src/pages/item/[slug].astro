---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WeeklyChart from '../../components/WeeklyChart.astro';
import { MARKETPLACE_ITEMS, getCategoryLabel, type MarketplaceItem } from '../../data/registry';
import { ArrowLeft, ArrowUpRight, Copy, Check, CircleCheck, Lock } from '@lucide/astro';

export function getStaticPaths(): Array<{ params: { slug: string }; props: { item: MarketplaceItem } }> {
  return MARKETPLACE_ITEMS.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  readonly item: MarketplaceItem;
}

const { item } = Astro.props;
const latestWeek = item.fallbackDownloads.weekly.at(-1)?.count ?? 0;
const primaryMethod = item.installMethods[0];
---

<BaseLayout title={`${item.name} — fvrvz.market`} description={item.tagline}>
  <section class="mp-section" style="padding-top: 2rem;">
    <div class="mp-container">
      <div class="flex items-center gap-2" style="margin-bottom: 1.5rem; font-size: 0.84rem; color: var(--mp-subtle);">
        <a href="/" class="mp-nav-link" style="padding: 0.2rem 0.45rem; display: inline-flex; align-items: center; gap: 0.35rem;">
          <ArrowLeft size={14} />
          Catalog
        </a>
        <span>/</span>
        <span>{getCategoryLabel(item.category)}</span>
        <span>/</span>
        <span style="color: var(--mp-text); font-weight: 600;">{item.name}</span>
      </div>

      <div class="mp-two-col">
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="mp-panel" style="padding: 0; overflow: hidden;">
            <img
              src={item.screenshot}
              alt={`${item.name} screenshot`}
              style="width: 100%; height: auto; display: block;"
            />
          </div>

          <div class="mp-panel">
            <div class="flex items-center justify-between gap-2" style="margin-bottom: 1rem; flex-wrap: wrap;">
              <div>
                <h3 style="margin: 0; font-size: 1rem; font-weight: 700;">Download Activity</h3>
                <p style="margin: 0.15rem 0 0; font-size: 0.8rem; color: var(--mp-subtle);">
                  Weekly trend · Last 8 weeks
                </p>
              </div>
              <div class="flex items-center gap-5">
                <div>
                  <div style="font-size: 1.25rem; font-weight: 800;" id="detail-total-downloads">
                    {item.fallbackDownloads.total.toLocaleString()}
                  </div>
                  <div style="font-size: 0.72rem; color: var(--mp-subtle);">Total</div>
                </div>
                <div>
                  <div style="font-size: 1.25rem; font-weight: 800; color: var(--mp-success);" id="detail-weekly-downloads">
                    {latestWeek.toLocaleString()}
                  </div>
                  <div style="font-size: 0.72rem; color: var(--mp-subtle);">This Week</div>
                </div>
              </div>
            </div>

            <WeeklyChart
              slug={item.slug}
              weekly={item.fallbackDownloads.weekly}
              accentColor={item.accentColor}
            />
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div class="mp-panel">
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.85rem;">
              <span class="mp-badge">{getCategoryLabel(item.category)}</span>
              <span class="mp-badge">{item.language}</span>
              <span class="mp-badge mp-mono">v{item.version}</span>
              <span class="mp-badge">{item.license}</span>
              {item.isPrivate && (
                <span class="mp-badge">
                  <Lock size={11} />
                  Private Preview
                </span>
              )}
            </div>

            <h1 style="margin: 0 0 0.5rem; font-size: clamp(1.75rem, 3.5vw, 2.3rem); font-weight: 800; letter-spacing: -0.03em;">
              {item.name}
            </h1>
            <p style="margin: 0 0 1.35rem; color: var(--mp-muted); font-size: 0.95rem;">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {item.links.landingPage && (
                <a
                  href={item.links.landingPage}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mp-btn mp-btn-primary"
                >
                  Visit Landing Page
                  <ArrowUpRight size={15} />
                </a>
              )}
              <a
                href={item.links.github}
                target="_blank"
                rel="noopener noreferrer"
                class={`mp-btn ${item.links.landingPage ? '' : 'mp-btn-primary'}`}
              >
                View on GitHub
                <ArrowUpRight size={15} />
              </a>
            </div>
          </div>

          {primaryMethod && (
            <div class="mp-panel">
              <div class="flex items-center justify-between gap-2" style="margin-bottom: 0.75rem; flex-wrap: wrap;">
                <h2 style="margin: 0; font-size: 1rem; font-weight: 700;">Installation</h2>
                <div class="mp-segmented" role="tablist" aria-label="Install method">
                  {item.installMethods.map((method, idx) => (
                    <button
                      type="button"
                      class="mp-seg-btn install-tab-btn"
                      data-active={String(idx === 0)}
                      data-command={method.command}
                      style="padding: 0.25rem 0.6rem; font-size: 0.75rem;"
                    >
                      {method.label}
                    </button>
                  ))}
                </div>
              </div>

              <div class="mp-cli-pill mp-mono" style="padding: 0.55rem 0.75rem; font-size: 0.82rem;">
                <span id="active-install-cmd" class="mp-cli-code">$ {primaryMethod.command}</span>
                <button
                  id="detail-copy-btn"
                  type="button"
                  class="mp-copy-icon-btn"
                  data-command={primaryMethod.command}
                  data-slug={item.slug}
                  aria-label="Copy install command"
                >
                  <Copy size={14} class="icon-copy" />
                  <Check size={14} class="icon-check" style="display: none; color: var(--mp-success);" />
                </button>
              </div>
            </div>
          )}

          <div class="mp-panel">
            <h2 style="margin: 0 0 0.75rem; font-size: 1rem; font-weight: 700;">Key Highlights</h2>
            <ul style="margin: 0 0 1.2rem; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.5rem;">
              {item.features.map((feat) => (
                <li class="flex items-center gap-2" style="font-size: 0.9rem; color: var(--mp-muted);">
                  <CircleCheck size={15} style="color: var(--mp-success); flex-shrink: 0;" />
                  <span>{feat}</span>
                </li>
              ))}
            </ul>

            <h3 style="margin: 0 0 0.5rem; font-size: 0.88rem; font-weight: 700;">Quick Start</h3>
            <pre
              style="margin: 0; padding: 0.9rem; border-radius: 10px; background: var(--mp-bg); border: 1px solid var(--mp-border); overflow-x: auto; font-size: 0.78rem; color: var(--mp-muted);"
            ><code>{item.quickStart}</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { fetchAllPackageStats, recordPackageDownload } from '../../lib/statsClient';

  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.install-tab-btn');
  const cmdDisplay = document.getElementById('active-install-cmd');
  const copyBtn = document.getElementById('detail-copy-btn') as HTMLButtonElement | null;
  const totalEl = document.getElementById('detail-total-downloads');
  const weeklyEl = document.getElementById('detail-weekly-downloads');
  const chartWrap = document.querySelector<HTMLElement>('[data-chart-slug]');
  const pageSlug = chartWrap?.dataset.chartSlug ?? '';

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.command ?? '';
      tabBtns.forEach((b) => b.setAttribute('data-active', String(b === btn)));
      if (cmdDisplay) cmdDisplay.textContent = `$ ${cmd}`;
      if (copyBtn) copyBtn.dataset.command = cmd;
    });
  });

  copyBtn?.addEventListener('click', async () => {
    const cmd = copyBtn.dataset.command ?? '';
    const slug = copyBtn.dataset.slug ?? '';
    if (!cmd) return;

    await navigator.clipboard.writeText(cmd);
    const copyIcon = copyBtn.querySelector<HTMLElement>('.icon-copy');
    const checkIcon = copyBtn.querySelector<HTMLElement>('.icon-check');
    if (copyIcon && checkIcon) {
      copyIcon.style.display = 'none';
      checkIcon.style.display = 'inline-flex';
      setTimeout(() => {
        copyIcon.style.display = 'inline-flex';
        checkIcon.style.display = 'none';
      }, 1500);
    }

    if (slug) {
      const updated = await recordPackageDownload(slug);
      if (updated) {
        if (totalEl) totalEl.textContent = updated.total.toLocaleString();
        const latest = updated.weekly.at(-1)?.count ?? 0;
        if (weeklyEl) weeklyEl.textContent = latest.toLocaleString();
      }
    }
  });

  if (pageSlug) {
    fetchAllPackageStats().then((stats) => {
      const pkg = stats?.[pageSlug];
      if (!pkg) return;
      if (totalEl) totalEl.textContent = pkg.total.toLocaleString();
      const latest = pkg.weekly.at(-1)?.count ?? 0;
      if (weeklyEl) weeklyEl.textContent = latest.toLocaleString();
    });
  }
</script>
