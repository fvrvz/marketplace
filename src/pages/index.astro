---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutDeveloper from '../components/AboutDeveloper.astro';
import ContactSection from '../components/ContactSection.astro';
import { MARKETPLACE_ITEMS, getCategoryLabel } from '../data/registry';
import { Search, Copy, Check, ArrowUpRight, ArrowRight, Download, Lock } from '@lucide/astro';

const totalFallbackDownloads = MARKETPLACE_ITEMS.reduce(
  (sum, item) => sum + item.fallbackDownloads.total,
  0,
);
const publicCount = MARKETPLACE_ITEMS.filter((i) => !i.isPrivate).length;
const ecosystemsCount = new Set(MARKETPLACE_ITEMS.map((i) => i.ecosystem)).size;
---

<BaseLayout title="fvrvz.market — Developer Marketplace & App Showcase">
  <section class="mp-hero">
    <div class="mp-container">
      <span class="mp-eyebrow mp-animate">
        <span class="mp-status-dot" aria-hidden="true"></span>
        Packages, UI Kits &amp; Apps by Faraaz Khan
      </span>
      <h1 class="mp-hero-title mp-animate">
        Developer tools &amp; apps built to ship faster.
      </h1>
      <p class="mp-hero-sub mp-animate">
        A curated registry of reusable Go packages, CSS utility frameworks, Angular UI components, Flutter apps, and self-hostable SaaS platforms.
      </p>
      <div class="flex flex-wrap gap-3 mp-animate">
        <a href="#catalog" class="mp-btn mp-btn-primary">
          Explore Catalog
          <ArrowRight size={15} />
        </a>
        <a href="#contact" class="mp-btn">Get in Touch</a>
      </div>

      <div class="mp-hero-metrics mp-animate">
        <div>
          <div class="mp-metric-val">{MARKETPLACE_ITEMS.length}</div>
          <div class="mp-metric-lbl">{publicCount} Public Projects</div>
        </div>
        <div>
          <div class="mp-metric-val" id="hero-total-downloads">{totalFallbackDownloads.toLocaleString()}</div>
          <div class="mp-metric-lbl">Total Downloads</div>
        </div>
        <div>
          <div class="mp-metric-val">{ecosystemsCount}</div>
          <div class="mp-metric-lbl">Languages &amp; Stacks</div>
        </div>
      </div>
    </div>
  </section>

  <section id="catalog" class="mp-section" style="padding-top: 1.5rem;">
    <div class="mp-container">
      <div class="mp-toolbar">
        <div class="mp-search-wrap">
          <Search
            size={15}
            style="position: absolute; left: 0.78rem; top: 50%; transform: translateY(-50%); color: var(--mp-subtle);"
          />
          <input
            id="catalog-search"
            type="search"
            class="mp-search-input"
            placeholder="Filter by name, stack, or tag..."
            aria-label="Search marketplace items"
          />
          <kbd class="mp-kbd" style="position: absolute; right: 0.65rem; top: 50%; transform: translateY(-50%);">/</kbd>
        </div>

        <div class="mp-segmented" role="tablist" aria-label="Filter by category">
          <button type="button" class="mp-seg-btn" data-filter="all" data-active="true">All</button>
          <button type="button" class="mp-seg-btn" data-filter="package">Packages</button>
          <button type="button" class="mp-seg-btn" data-filter="ui-kit">UI Kits</button>
          <button type="button" class="mp-seg-btn" data-filter="saas">SaaS</button>
          <button type="button" class="mp-seg-btn" data-filter="app">Apps</button>
          <button type="button" class="mp-seg-btn" data-filter="coming-soon">Coming Soon</button>
        </div>
      </div>

      <div id="catalog-grid" class="mp-grid">
        {MARKETPLACE_ITEMS.map((item) => {
          const primaryInstall = item.installMethods[0];

          return (
            <article
              class="mp-card mp-animate"
              data-slug={item.slug}
              data-category={item.category}
              data-status={item.status}
              data-search={`${item.name} ${item.tagline} ${item.language} ${item.ecosystem} ${item.tags.join(' ')}`.toLowerCase()}
            >
              <a href={`/item/${item.slug}`} class="mp-card-media" aria-label={`View ${item.name} details`}>
                <img src={item.screenshot} alt={`${item.name} preview`} loading="lazy" />
                <div class="mp-card-float">
                  <span class="mp-chip">{getCategoryLabel(item.category)}</span>
                  <span class="mp-chip">
                    {item.isPrivate && <Lock size={11} />}
                    {item.language}
                  </span>
                </div>
              </a>

              <div class="mp-card-body">
                <div>
                  <div class="flex items-center justify-between gap-2">
                    <h2 class="mp-card-title">
                      <a href={`/item/${item.slug}`} style="color: inherit; text-decoration: none;">
                        {item.name}
                      </a>
                    </h2>
                    <span class="flex items-center gap-1 mp-mono" style="font-size: 0.76rem; color: var(--mp-subtle);">
                      <Download size={12} />
                      <span data-download-count={item.slug}>
                        {item.fallbackDownloads.total.toLocaleString()}
                      </span>
                    </span>
                  </div>
                  <p class="mp-card-desc">{item.tagline}</p>
                </div>

                {primaryInstall && (
                  <div class="mp-cli-pill mp-mono">
                    <span class="mp-cli-code">$ {primaryInstall.command}</span>
                    <button
                      type="button"
                      class="mp-copy-icon-btn copy-install-btn"
                      data-copy-command={primaryInstall.command}
                      data-copy-slug={item.slug}
                      aria-label={`Copy install command for ${item.name}`}
                    >
                      <Copy size={13} class="icon-copy" />
                      <Check size={13} class="icon-check" style="display: none; color: var(--mp-success);" />
                    </button>
                  </div>
                )}

                <div class="flex items-center justify-between gap-2" style="margin-top: auto; padding-top: 0.25rem;">
                  <a href={`/item/${item.slug}`} class="mp-btn mp-btn-primary" style="flex: 1;">
                    Explore
                    <ArrowRight size={14} />
                  </a>
                  <a
                    href={item.links.landingPage ?? item.links.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mp-btn"
                    title={item.links.landingPage ? 'Visit Landing Page' : 'View on GitHub'}
                  >
                    {item.links.landingPage ? 'Site' : 'Repo'}
                    <ArrowUpRight size={14} />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <p id="catalog-empty" style="display: none; text-align: center; color: var(--mp-subtle); padding: 3rem 0;">
        No projects match your current filter.
      </p>
    </div>
  </section>

  <AboutDeveloper />
  <ContactSection />
</BaseLayout>

<script>
  import { fetchAllPackageStats, recordPackageDownload } from '../lib/statsClient';

  const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#catalog-grid [data-slug]');
  const emptyState = document.getElementById('catalog-empty');

  let activeFilter = 'all';

  const applyFilters = (): void => {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.dataset.category ?? '';
      const status = card.dataset.status ?? '';
      const searchBlob = card.dataset.search ?? '';

      const matchesFilter =
        activeFilter === 'all' ||
        (activeFilter === 'coming-soon' ? status === 'coming-soon' : category === activeFilter);
      const matchesQuery = query.length === 0 || searchBlob.includes(query);

      const visible = matchesFilter && matchesQuery;
      card.style.display = visible ? 'flex' : 'none';
      if (visible) visibleCount += 1;
    });

    if (emptyState) {
      emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      tabButtons.forEach((b) => b.setAttribute('data-active', String(b === btn)));
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);

  window.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      document.activeElement?.tagName !== 'INPUT' &&
      document.activeElement?.tagName !== 'TEXTAREA'
    ) {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-install-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const command = btn.dataset.copyCommand ?? '';
      const slug = btn.dataset.copySlug ?? '';
      if (!command) return;

      await navigator.clipboard.writeText(command);
      const copyIcon = btn.querySelector<HTMLElement>('.icon-copy');
      const checkIcon = btn.querySelector<HTMLElement>('.icon-check');
      if (copyIcon && checkIcon) {
        copyIcon.style.display = 'none';
        checkIcon.style.display = 'inline-flex';
        setTimeout(() => {
          copyIcon.style.display = 'inline-flex';
          checkIcon.style.display = 'none';
        }, 1400);
      }

      if (slug) {
        const updated = await recordPackageDownload(slug);
        if (updated) {
          const countEl = document.querySelector<HTMLElement>(`[data-download-count="${slug}"]`);
          if (countEl) countEl.textContent = updated.total.toLocaleString();
        }
      }
    });
  });

  fetchAllPackageStats().then((stats) => {
    if (!stats) return;
    let grandTotal = 0;
    for (const [slug, pkgStats] of Object.entries(stats)) {
      grandTotal += pkgStats.total;
      const el = document.querySelector<HTMLElement>(`[data-download-count="${slug}"]`);
      if (el) el.textContent = pkgStats.total.toLocaleString();
    }
    const heroTotal = document.getElementById('hero-total-downloads');
    if (heroTotal && grandTotal > 0) {
      heroTotal.textContent = grandTotal.toLocaleString();
    }
  });
</script>
