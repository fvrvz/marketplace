---
import type { WeeklyDownloadPoint } from '../data/registry';

interface Props {
  readonly slug: string;
  readonly weekly: readonly WeeklyDownloadPoint[];
  readonly accentColor: string;
}

const { slug, weekly, accentColor } = Astro.props;
const maxCount = Math.max(1, ...weekly.map((w) => w.count));
const width = 560;
const height = 185;
const padX = 24;
const padY = 24;
const chartW = width - padX * 2;
const chartH = height - padY * 2;
const barGap = 10;
const barW = weekly.length > 0 ? Math.max(20, (chartW - barGap * (weekly.length - 1)) / weekly.length) : 24;
---

<div class="mp-chart-wrap" data-chart-slug={slug}>
  {weekly.length === 0 ? (
    <p style="color: var(--mp-subtle); font-size: 0.88rem; margin: 0; padding: 1rem 0;">
      Analytics will appear once this library is publicly released.
    </p>
  ) : (
    <svg
      viewBox={`0 0 ${width} ${height}`}
      style="width: 100%; height: auto; display: block;"
      role="img"
      aria-label={`Weekly downloads chart for ${slug}`}
    >
      <defs>
        <linearGradient id={`bar-grad-${slug}`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color={accentColor} stop-opacity="0.95" />
          <stop offset="100%" stop-color={accentColor} stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <line x1={padX} y1={height - padY} x2={width - padX} y2={height - padY} stroke="var(--mp-border)" stroke-width="1" />
      {weekly.map((point, index) => {
        const barH = Math.max(8, (point.count / maxCount) * (chartH - 18));
        const x = padX + index * (barW + barGap);
        const y = height - padY - barH;
        const shortLabel = point.week.slice(5);
        return (
          <g>
            <rect
              x={x}
              y={y}
              width={barW}
              height={barH}
              rx="6"
              fill={`url(#bar-grad-${slug})`}
            >
              <title>{`Week of ${point.week}: ${point.count} downloads`}</title>
            </rect>
            <text
              x={x + barW / 2}
              y={y - 6}
              text-anchor="middle"
              fill="var(--mp-muted)"
              font-size="10.5"
              font-family="JetBrains Mono, ui-monospace, monospace"
            >
              {point.count}
            </text>
            <text
              x={x + barW / 2}
              y={height - 5}
              text-anchor="middle"
              fill="var(--mp-subtle)"
              font-size="10"
              font-family="Inter, ui-sans-serif, system-ui, sans-serif"
            >
              {shortLabel}
            </text>
          </g>
        );
      })}
    </svg>
  )}
</div>
