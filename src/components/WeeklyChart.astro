---
import type { WeeklyDownloadPoint } from '../data/registry';

interface Props {
  readonly slug: string;
  readonly weekly: readonly WeeklyDownloadPoint[];
  readonly accentColor: string;
}

const { slug, weekly, accentColor } = Astro.props;
const maxCount = Math.max(1, ...weekly.map((w) => w.count));
const width = 560;
const height = 180;
const padX = 28;
const padY = 20;
const chartW = width - padX * 2;
const chartH = height - padY * 2;
const barGap = 10;
const barW = weekly.length > 0 ? Math.max(18, (chartW - barGap * (weekly.length - 1)) / weekly.length) : 24;
---

<div class="mp-chart-wrap" data-chart-slug={slug}>
  {weekly.length === 0 ? (
    <p style="color: var(--mp-muted); font-size: 0.9rem; margin: 0;">
      No download history yet — this package is in private preview.
    </p>
  ) : (
    <svg
      viewBox={`0 0 ${width} ${height}`}
      style="width: 100%; height: auto; display: block;"
      role="img"
      aria-label={`Weekly downloads chart for ${slug}`}
    >
      <line x1={padX} y1={height - padY} x2={width - padX} y2={height - padY} stroke="var(--mp-border)" stroke-width="1" />
      {weekly.map((point, index) => {
        const barH = Math.max(6, (point.count / maxCount) * (chartH - 18));
        const x = padX + index * (barW + barGap);
        const y = height - padY - barH;
        const shortLabel = point.week.slice(5);
        return (
          <g>
            <rect
              x={x}
              y={y}
              width={barW}
              height={barH}
              rx="5"
              fill={accentColor}
              fill-opacity="0.82"
            >
              <title>{`${point.week}: ${point.count} downloads`}</title>
            </rect>
            <text
              x={x + barW / 2}
              y={y - 5}
              text-anchor="middle"
              fill="var(--mp-muted)"
              font-size="10"
              font-family="ui-monospace, monospace"
            >
              {point.count}
            </text>
            <text
              x={x + barW / 2}
              y={height - 4}
              text-anchor="middle"
              fill="var(--mp-muted)"
              font-size="10"
              font-family="ui-sans-serif, system-ui, sans-serif"
            >
              {shortLabel}
            </text>
          </g>
        );
      })}
    </svg>
  )}
</div>
