---
import { Mail, Send } from '@lucide/astro';
---

<section id="contact" class="mp-section" style="padding-top: 1rem;">
  <div class="mp-container">
    <div class="mp-panel mp-reveal">
      <div class="mp-two-col">
        <div>
          <span class="mp-eyebrow" style="margin-bottom: 0.65rem;">
            <Mail size={13} />
            Get in Touch
          </span>
          <h2 style="margin: 0.35rem 0 0.55rem; font-size: 1.55rem; font-weight: 800; letter-spacing: -0.02em;">
            Questions, feedback, or collaborations?
          </h2>
          <p style="color: var(--mp-muted); margin: 0 0 1.15rem; font-size: 0.92rem;">
            Drop a note below and I&apos;ll get back to you soon. Whether it&apos;s integrating a package, reporting an issue, or exploring early access to upcoming tools, I&apos;d love to hear from you.
          </p>
          <div style="display: flex; flex-direction: column; gap: 0.45rem; color: var(--mp-subtle); font-size: 0.86rem;">
            <span>• Package &amp; UI kit integration support</span>
            <span>• Custom SaaS or self-hosted deployments</span>
            <span>• Early access to upcoming libraries</span>
          </div>
        </div>

        <form id="contact-form" novalidate style="display: flex; flex-direction: column; gap: 0.85rem;">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem;">
            <div>
              <label for="contact-name" style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.28rem;">
                Name
              </label>
              <input id="contact-name" name="name" type="text" class="mp-input" placeholder="Your name" required />
              <div class="mp-error" data-error-for="name"></div>
            </div>

            <div>
              <label for="contact-email" style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.28rem;">
                Email
              </label>
              <input id="contact-email" name="email" type="email" class="mp-input" placeholder="you@example.com" required />
              <div class="mp-error" data-error-for="email"></div>
            </div>
          </div>

          <div>
            <label for="contact-subject" style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.28rem;">
              Subject
            </label>
            <input id="contact-subject" name="subject" type="text" class="mp-input" placeholder="How can I help?" required />
            <div class="mp-error" data-error-for="subject"></div>
          </div>

          <div>
            <label for="contact-message" style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 0.28rem;">
              Message
            </label>
            <textarea id="contact-message" name="message" rows="4" class="mp-textarea" placeholder="Tell me about what you're building..." required></textarea>
            <div class="mp-error" data-error-for="message"></div>
          </div>

          <div class="flex items-center justify-between gap-3" style="flex-wrap: wrap;">
            <button id="contact-submit" type="submit" class="mp-btn mp-btn-primary">
              <Send size={15} />
              Send Message
            </button>
            <span id="contact-status" style="font-size: 0.84rem; color: var(--mp-muted);"></span>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { z } from 'zod';
  import { getApiBaseUrl } from '../lib/statsClient';

  const ContactFormSchema = z.object({
    name: z.string().trim().min(2, 'Name must be at least 2 characters').max(100),
    email: z.email('Please enter a valid email address'),
    subject: z.string().trim().min(3, 'Subject must be at least 3 characters').max(140),
    message: z.string().trim().min(10, 'Message must be at least 10 characters').max(2000),
  });

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('contact-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  const clearErrors = (): void => {
    document.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
      el.textContent = '';
    });
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      subject: String(formData.get('subject') ?? ''),
      message: String(formData.get('message') ?? ''),
    };

    const parsed = ContactFormSchema.safeParse(payload);
    if (!parsed.success) {
      for (const issue of parsed.error.issues) {
        const field = String(issue.path[0] ?? '');
        const errEl = document.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
        if (errEl) errEl.textContent = issue.message;
      }
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (statusEl) {
      statusEl.style.color = 'var(--mp-muted)';
      statusEl.textContent = 'Sending message...';
    }

    try {
      const response = await fetch(`${getApiBaseUrl()}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(parsed.data),
      });

      if (!response.ok) {
        throw new Error('Failed to send message');
      }

      form.reset();
      if (statusEl) {
        statusEl.style.color = 'var(--mp-success)';
        statusEl.textContent = 'Message sent! Thanks for reaching out.';
      }
    } catch {
      if (statusEl) {
        statusEl.style.color = 'var(--mp-danger)';
        statusEl.textContent = 'Could not send right now. Please try again or reach out on LinkedIn.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
